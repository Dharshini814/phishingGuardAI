# PhishGuard AI Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Model Settings
RANDOM_STATE=42
TEST_SIZE=0.2

# Risk Score Thresholds
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60

# Database (optional - currently using in-memory)
# DATABASE_URL=postgresql://user:password@localhost/phishguard

# Logging
LOG_LEVEL=INFO